nextflow_process {

    name "Test HARMONISE_GWAMA"
    script "modules/local/harmonise_gwama.nf"
    process "HARMONISE_GWAMA"

    test("gwama demo harmonises to the hub columns") {
        when {
            process {
                """
                input[0] = [
                    [ id:'demo', format:'gwama', n:9500, ancestry:'EUR', trait:'Demo', build:'GRCh37' ],
                    file("${projectDir}/assets/test/gwama_demo.tsv")
                ]
                input[1] = file("${projectDir}/assets/test/snp.info")
                """
            }
        }
        then {
            assert process.success
            def lines = path(process.out.harmonised[0][1]).linesGzip
            // canonical hub header
            assert lines[0] == "rsid\tchr\tpos\tea\toa\teaf\tbeta\tse\tp\tn\tz"
            // rs7 is absent from snp.info -> dropped on join (8 input -> 7 data rows).
            def data = lines.findAll { it ==~ /^rs\d.*/ }
            assert data.size() == 7
            // rs3 flip: GWAMA reference_allele=A == ref A2, so ea stays ref A1=G,
            // beta sign flipped to negative, eaf -> 1 - 0.81 = 0.19
            def rs3 = data.find { it.startsWith("rs3\t") }.split("\t")
            assert rs3[3] == "G"                        // ea == ref A1
            assert rs3[4] == "A"                        // oa == ref A2
            assert (rs3[6] as double) < 0               // beta flipped negative
            assert Math.abs((rs3[5] as double) - 0.19) < 1e-9   // eaf flipped
            // fixed N injected from meta.n
            assert (rs3[9] as double) == 9500
            // rs5 has eaf == -9 (GWAMA missing-value sentinel): must NOT leak -9/10
            // into the hub; falls back to the LD reference A1Freq (snp.info rs5 = 0.10)
            def rs5 = data.find { it.startsWith("rs5\t") }.split("\t")
            assert Math.abs((rs5[5] as double) - 0.10) < 1e-9
            // no row may carry the sentinel as a frequency
            data.each { assert !(it.split("\t")[5] in ["-9", "10"]) }
        }
    }

    test("gwama with rsIDs in rs_number harmonises without a map") {
        // Real GWAMA output carries rsIDs in `rs_number` when input studies used
        // rsID marker names (e.g. the MAGIC glucose meta-analysis). No rsid column,
        // no chr:pos -> the rsID must be taken directly from rs_number (path #1).
        when {
            process {
                """
                input[0] = [
                    [ id:'rsnum', format:'gwama', n:9500, ancestry:'EUR', trait:'Demo', build:'GRCh37' ],
                    file("${projectDir}/assets/test/gwama_rsnum_demo.tsv")
                ]
                input[1] = file("${projectDir}/assets/test/snp.info")
                """
            }
        }
        then {
            assert process.success
            def lines = path(process.out.harmonised[0][1]).linesGzip
            assert lines[0] == "rsid\tchr\tpos\tea\toa\teaf\tbeta\tse\tp\tn\tz"
            def data = lines.findAll { it ==~ /^rs\d.*/ }
            assert data.size() == 7                          // rs7 absent from snp.info
            def rs3 = data.find { it.startsWith("rs3\t") }.split("\t")
            assert rs3[3] == "G" && rs3[4] == "A"            // oriented to ref A1/A2
            assert (rs3[6] as double) < 0                    // beta flipped
        }
    }

    test("build matcher: chr:pos on the panel build resolves rsIDs from snp.info") {
        // rs_number is chr:pos, no rsid column, no external map. Because the input
        // build (GRCh37) equals the panel build, the build matcher derives the
        // chr:pos -> rsID map straight from snp.info.
        when {
            process {
                """
                input[0] = [
                    [ id:'chrpos', format:'gwama', n:9500, ancestry:'EUR', trait:'Demo', build:'GRCh37' ],
                    file("${projectDir}/assets/test/gwama_chrpos_demo.tsv")
                ]
                input[1] = file("${projectDir}/assets/test/snp.info")
                """
            }
        }
        then {
            assert process.success
            def lines = path(process.out.harmonised[0][1]).linesGzip
            assert lines[0] == "rsid\tchr\tpos\tea\toa\teaf\tbeta\tse\tp\tn\tz"
            def data = lines.findAll { it ==~ /^rs\d.*/ }
            assert data.size() == 7                          // 7:7007 not in the panel
            def rs3 = data.find { it.startsWith("rs3\t") }.split("\t")
            assert rs3[3] == "G" && rs3[4] == "A" && (rs3[6] as double) < 0
        }
    }

    test("build matcher: chr:pos on a non-panel build with no map fails loudly") {
        // Same chr:pos input declared as GRCh38 (!= panel GRCh37) and no map: the
        // build matcher cannot resolve rsIDs and must error rather than silently drop.
        when {
            process {
                """
                input[0] = [
                    [ id:'mismatch', format:'gwama', n:9500, ancestry:'EUR', trait:'Demo', build:'GRCh38' ],
                    file("${projectDir}/assets/test/gwama_chrpos_demo.tsv")
                ]
                input[1] = file("${projectDir}/assets/test/snp.info")
                """
            }
        }
        then {
            assert process.failed
        }
    }
}
