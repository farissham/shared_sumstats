/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SNP-set profile: HapMap3 (default)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Uses the ukbEUR_HM3 LD reference (~1.1M SNPs, 591 eigen blocks) bundled under
    ../masters/data/. BaselineLD v2.2 annotations from the same tree.
----------------------------------------------------------------------------------------
*/

params {
    snp_set      = 'hm3'
    ld_ref_dir   = "${params.data_dir}/ld_ref/ukbEUR_HM3"
    annot_file   = "${params.data_dir}/annotations/annot_baseline2.2.txt"

    // LDSC EUR HapMap3 LD scores + SNP list (1000G Phase 3, Zenodo 8182036)
    ldsc_ld_dir  = "${params.data_dir}/ldsc_ref/eur_w_ld_chr"
    ldsc_snplist = "${params.data_dir}/ldsc_ref/eur_w_ld_chr/w_hm3.snplist"
}
